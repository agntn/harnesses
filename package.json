{
  "name": "agmi",
  "version": "0.0.1",
  "description": "Agnostic metadata toolkit for AI tools: binaries, configs, sessions, and storage formats.",
  "homepage": "https://github.com/oritwoen/aixa#readme",
  "bugs": "https://github.com/oritwoen/aixa/issues",
  "license": "MIT",
  "author": "oritwoen (https://github.com/oritwoen)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oritwoen/aixa.git"
  },
  "bin": {
    "aixa": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "obuild",
    "dev": "obuild --stub",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint . --fix && oxfmt .",
    "typecheck": "tsgo --noEmit --skipLibCheck",
    "test": "vitest",
    "test:run": "vitest --run",
    "prepack": "pnpm run build",
    "release": "pnpm test:run && pnpm build && changelogen --release --push"
  },
  "dependencies": {
    "@toon-format/toon": "^2.1.0",
    "citty": "^0.2.1",
    "consola": "^3.4.2"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@typescript/native-preview": "latest",
    "changelogen": "latest",
    "obuild": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "typescript": "latest",
    "vitest": "latest"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.30.3"
}
