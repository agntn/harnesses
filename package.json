{
  "name": "@agntn/harnesses",
  "version": "0.4.2",
  "description": "Metadata registry for AI coding harnesses: binaries, configs, sessions, and capabilities.",
  "homepage": "https://harnesses.agntn.dev",
  "bugs": "https://github.com/agntn/harnesses/issues",
  "license": "MIT",
  "author": "oritwoen (https://github.com/oritwoen)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agntn/harnesses.git"
  },
  "bin": {
    "harnesses": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "extensions/omp",
    "extensions/pi",
    "extensions/shared"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./mcp": {
      "types": "./dist/mcp.d.mts",
      "import": "./dist/mcp.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "obuild",
    "dev": "obuild --stub",
    "docs": "pnpm --filter docs dev",
    "lint": "pnpm build && vp lint && vp fmt --check",
    "lint:fix": "pnpm build && vp lint --fix && vp fmt && pnpm build",
    "typecheck": "tsgo --noEmit --skipLibCheck && pnpm build && tsgo --noEmit --skipLibCheck -p tsconfig.extensions.json",
    "test": "vp test watch",
    "test:run": "vp test run",
    "prepack": "pnpm run build",
    "release": "pnpm test:run && pnpm build && changelogen --release --push"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:deps",
    "@toon-format/toon": "catalog:deps",
    "citty": "catalog:deps",
    "consola": "catalog:deps",
    "smol-toml": "catalog:deps",
    "yaml": "catalog:deps"
  },
  "devDependencies": {
    "@agntn/ox": "catalog:dev",
    "@earendil-works/pi-coding-agent": "catalog:dev",
    "@earendil-works/pi-tui": "catalog:dev",
    "@oh-my-pi/omptype": "catalog:dev",
    "@oh-my-pi/pi-ai": "catalog:dev",
    "@oh-my-pi/pi-coding-agent": "catalog:dev",
    "@types/node": "latest",
    "@typescript/native-preview": "latest",
    "changelogen": "catalog:dev",
    "obuild": "catalog:dev",
    "typebox": "catalog:dev",
    "typescript": "catalog:dev",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.99.0 <1",
    "@earendil-works/pi-tui": ">=0.84.2 <1",
    "@oh-my-pi/pi-coding-agent": ">=18.0.0 <19",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.15.0",
  "omp": {
    "extensions": [
      "./extensions/omp/harnesses.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./extensions/pi/harnesses.ts"
    ],
    "image": "https://harnesses.agntn.dev/image.png"
  }
}
