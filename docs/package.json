    "docus": "5.13.0",
    "nuxt": "4.5.2"
  },
  "devDependencies": {
    "@iconify-json/lucide": "1.2.136",
    "@iconify-json/simple-icons": "1.2.97",
    "@iconify-json/solar": "1.2.12",
    "@iconify-json/vscode-icons": "1.2.81",
    "wrangler": "4.134.0"
  },
  "packageManager": "pnpm@12.4.2"
}
