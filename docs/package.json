{
  "name": "docs",
  "private": true,
  "type": "module",
  "scripts": {
    "snapshot": "node scripts/snapshot.mjs",
    "dev": "nuxt dev --extends docus",
    "build": "pnpm snapshot && NUXT_SITE_URL=https://harnesses.agntn.dev nuxt build --extends docus",
    "generate": "NUXT_SITE_URL=https://harnesses.agntn.dev nuxt generate --extends docus",
    "preview": "nuxt preview --extends docus",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "docus": "5.13.0",
    "nuxt": "4.5.2"
  },
  "devDependencies": {
    "@iconify-json/lucide": "1.2.128",
    "@iconify-json/simple-icons": "1.2.94",
    "@iconify-json/solar": "1.2.10",
    "@iconify-json/vscode-icons": "1.2.76",
    "wrangler": "4.128.0"
  },
  "packageManager": "pnpm@11.3.0"
}
